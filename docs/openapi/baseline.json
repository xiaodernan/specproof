{
  "openapi": "3.1.0",
  "info": {
    "title": "SpecProof Phase 1",
    "description": "Reliable Verification Job API",
    "version": "0.1.0"
  },
  "paths": {
    "/jobs": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Create Job",
        "description": "Create a verification job and its Outbox event in ONE MySQL transaction.\n\nThe job row and the outbox row commit together: if the API crashes before\nresponding, the relay still publishes the event (at-least-once). The\nconsumer is idempotent, so a duplicate delivery cannot double-process.\n\nReturns 202 with job_id. A real 503 when MySQL is unreachable — the API\nnever pretends a job was accepted when nothing was persisted.",
        "operationId": "create_job_jobs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCreateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Create Job Jobs Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "List Jobs",
        "description": "List the most recent verification jobs.",
        "operationId": "list_jobs_jobs_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response List Jobs Jobs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/cancel": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Cancel Job",
        "description": "Cancel a QUEUED/RUNNING job (CAS; terminal jobs are immutable).",
        "operationId": "cancel_job_jobs__job_id__cancel_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Cancel Job Jobs  Job Id  Cancel Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job",
        "description": "Return one job's status from MySQL (the business source of truth).",
        "operationId": "get_job_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Job Jobs  Job Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/summary": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job Summary",
        "description": "Return the persisted pipeline summary (matrix/findings/capsules).",
        "operationId": "get_job_summary_jobs__job_id__summary_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Job Summary Jobs  Job Id  Summary Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/progress": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Job Progress",
        "description": "SSE endpoint for job progress. Supports reconnection via Last-Event-ID.\n\nEvent format:\n    id: <stream-entry-id>\n    event: progress\n    data: {\"node\": \"...\", \"status\": \"...\", \"percent\": N, \"message\": \"...\"}\n\nThe client disconnects, then reconnects with Last-Event-ID header set to\nthe last received event id. The server resumes from that position.",
        "operationId": "job_progress_jobs__job_id__progress_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/github": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Github Webhook",
        "description": "Verify and ingest a GitHub event (pull_request family).",
        "operationId": "github_webhook_webhooks_github_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Github Webhook Webhooks Github Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dashboard": {
      "get": {
        "tags": [
          "web"
        ],
        "summary": "Dashboard",
        "description": "Aggregate job stats, 24h timeline and cost/token availability.\n\nMySQL is the source of truth for jobs. When it is unreachable the\nendpoint still answers 200 with \"degraded: true\" and empty\naggregates - the UI must render the degradation, not fake numbers.",
        "operationId": "dashboard_api_v1_dashboard_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Dashboard Api V1 Dashboard Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/stages": {
      "get": {
        "tags": [
          "web"
        ],
        "summary": "Job Stages",
        "description": "Pipeline stage timeline for one job (Redis progress stream).\n\nRedis is optional telemetry: when it is down the endpoint still\nanswers 200 with \"degraded: true\" and an empty stage list.",
        "operationId": "job_stages_api_v1_jobs__job_id__stages_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Job Stages Api V1 Jobs  Job Id  Stages Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/matrix": {
      "get": {
        "tags": [
          "web"
        ],
        "summary": "Job Matrix",
        "description": "Requirement-to-evidence matrix rows for one job (contracts table).\n\nThe contracts table stores per-contract results (PASS/FAIL/UNVERIFIED)\nwith requirement text and evidence refs; summary counts are returned\nalongside. Empty rows are honest, not fabricated.",
        "operationId": "job_matrix_api_v1_jobs__job_id__matrix_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Job Matrix Api V1 Jobs  Job Id  Matrix Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/findings": {
      "get": {
        "tags": [
          "web"
        ],
        "summary": "Job Findings",
        "description": "Findings for one job (summary JSON merged with the findings table).\n\nThe pipeline summary carries descriptions; the findings table adds\ncapsule paths and impact paths. Both may be empty - an empty list is\nan honest answer, 404 is reserved for unknown jobs.",
        "operationId": "job_findings_api_v1_jobs__job_id__findings_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Job Findings Api V1 Jobs  Job Id  Findings Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/certificate": {
      "get": {
        "tags": [
          "web"
        ],
        "summary": "Job Certificate",
        "description": "Merge Certificate / Rejection Notice for a job, when persisted.\n\nCertificates are written by the CLI verify flow (reports dir). The\nAPI never reconstructs one from scratch: no artifact means 404.",
        "operationId": "job_certificate_api_v1_jobs__job_id__certificate_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Job Certificate Api V1 Jobs  Job Id  Certificate Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },

      "get": {
        "tags": [
          "web"
        ],
        "summary": "List Contracts",
        "description": "Contract registry rows with approval-status filtering.",
        "operationId": "list_contracts_api_v1_contracts_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "all",
              "title": "Status"
            }
          },
          {
            "name": "repo_path",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ],
              "title": "Repo Path"
            }
          }
        ],
        "responses": {
          "200": {

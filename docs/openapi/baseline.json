      "get": {
        "tags": [
          "web"
        ],
        "summary": "Eval Latest",
        "description": "Latest persisted evaluation report (docs/eval/eval-report.results.json).",
        "operationId": "eval_latest_api_v1_eval_latest_get",
        "responses": {
          "200": {
            "description": "Successful Response",

# SpecProof Phase 0
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ============================================================
# LLM Provider
# ============================================================
# NOT DELIVERED IN COMPOSE, ON PURPOSE (gate #257: D02 defers the delivery,
# D07 requires this sentence to exist). compose.production.yml interpolates
# none of the five provider names below because the shipped loader keys on
# PRESENCE, not truthiness: providers/config.py builds its environment view
# with `if name in os.environ`, and save_model_config() refuses every write
# while any of the five is present. So a `${NAME:-}` pass-through would not be
# a harmless default - it would set all five in every container, make the
# deployed stack report an environment-managed provider whose empty values
# clear a key saved through the settings page, and lock that page permanently.
# Filling these rows changes nothing for a compose deployment; point the
# running process at your provider instead (its own environment, or the model
# file the loader reads while no provider name is present).
LLM_BASE_URL=https://your-provider.example.com/v1
# Deferred (#257 D02): compose gives this name no carrier either - the
# reason is the block above LLM_BASE_URL, of which this row is part.
LLM_API_KEY=replace_me
# Model and protocol. Workspace access uses SPECPROOF_API_KEY, not LLM_API_KEY.
# Deferred (#257 D02): no carrier, like LLM_BASE_URL - see that block.
LLM_MODEL=gpt-6-astra
# Deferred (#257 D02): no carrier, like LLM_BASE_URL - see that block.
LLM_PROTOCOL=responses
# Deferred (#257 D02): no carrier, like LLM_BASE_URL - see that block.
LLM_REASONING_EFFORT=max
# Thinking-mode policy for task templates (providers/prompt_templates.py):
#   plan_only (default) — request thinking only for plan/judge/diagnose tasks;
#   auto       — follow each template's thinking_on flag;
#   off        — never request thinking (the gateway's always-on thinking may
#                still run; this only stops the client from requesting it).
LLM_THINKING_MODE=plan_only
# Per-run Craft resource gate. These five names are the only variables
# craft/budget.py Budget.from_env reads; `specproof craft --budget-tokens`
# overrides CRAFT_TOKEN_BUDGET for one run. Each must be a positive integer:
# Budget._env_int raises BudgetError on 0, a negative, or a non-numeric
# value, so "0 = no enforcement" is NOT a thing here (the row this replaced
# claimed it). Values below are read from craft/budget.py's own DEFAULT_*
# constants.
# CAVEAT, disclosed not hidden: CRAFT_TOKEN_BUDGET has TWO defaults in the
#   craft/budget.py -> 200000
#   craft/llm.py -> 500000
# The budget that gates the run is the one above from budget.py; the LLM
# client's own cap differs, and the CLI help text quotes only one of them.
CRAFT_MAX_ITERATIONS=12
CRAFT_MAX_STEPS=12
CRAFT_MAX_TOOL_CALLS=40
# Deferred (#257 D02): compose gives this name no carrier because the two
# defaults quoted above disagree. A `${CRAFT_TOKEN_BUDGET:-200000}` would set
# the value in every container, so craft/llm.py's own 500000 default would
# stop applying - a real behaviour change, not a default. The run-level
# budget stays the row's value only outside compose, where nothing sets it.
CRAFT_TOKEN_BUDGET=200000
CRAFT_TIMEOUT_MINUTES=60
LLM_MAX_RETRIES=2

# ============================================================
# Deployment mode (arms the production credential guard)
# ============================================================
# storage/config_guard.py runs its refusal checks only when this equals
# `production`, and api/server.py calls the guard at import. compose.production.yml
# sets it for every app service, so a deployed stack is armed whether or not this
# file exists; the row covers the plane OUTSIDE compose, where an unset value
# leaves the guard inert and a shipped default password boots without complaint.
# It stays commented on purpose: uncommenting it in a dev checkout makes the guard
# reject this file's own dev defaults (MYSQL_USER=specproof, MINIO_ROOT_USER=minioadmin)
# until they are changed - which is the point, not a side effect.
# Reachability of the guard is gated by tests/unit/test_production_guard_reachability.py
# (#79); that the knob is inventoried here is gated by
# tests/unit/test_compose_required_knobs_reach_the_operator.py (R07).
# SPECPROOF_ENV=production

# ============================================================
# MySQL (Phase 0 — business truth)
# ============================================================
MYSQL_HOST=localhost
# Host-publish port only (compose ${MYSQL_PORT:-3306}); the app containers reach
# mysql on the compose network at 3306 and no app service reads this name,
# so moving it does not move the endpoint they use (#257 D02 defers it).
MYSQL_PORT=3306
MYSQL_DATABASE=specproof_phase0
# The account name is part of the credential: storage/config_guard.py refuses
# SPECPROOF_ENV=production while MYSQL_USER still equals `specproof`, the account
# the product database is seeded with. The value stays equal to compose.phase0.yml's
# own `${MYSQL_USER:-specproof}` fallback because that is what makes a copied
# template boot (gate #235 L03 pins the two together), so the row is a DEV default
# that has to change before production - disclosed here, not silently replaced.
MYSQL_USER=specproof
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_me
# Socket deadlines in seconds keep unavailable databases from hanging requests.
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=15
MYSQL_WRITE_TIMEOUT=15
# Bounded MySQL connection pool (performance lane): one process holds at most
# this many connections, and an acquire wait longer than this fails instead of
# hanging the request. 8 / 5.0 are the values this repo gates and ships.
MYSQL_POOL_SIZE=8
MYSQL_POOL_ACQUIRE_TIMEOUT=5.0

# ============================================================
# MongoDB (Phase 0 — analysis artifacts)
# ============================================================
MONGODB_HOST=localhost
# Host-publish port only (compose ${MONGODB_PORT:-27017}); the app containers reach
# mongodb on the compose network at 27017 and no app service reads this name,
# so moving it does not move the endpoint they use (#257 D02 defers it).
MONGODB_PORT=27017
MONGODB_DATABASE=specproof_phase0
MONGODB_USER=specproof
MONGODB_PASSWORD=replace_me

# ============================================================
# Elasticsearch (Phase 0 — code retrieval)
# ============================================================
ES_HOST=http://localhost:9200
# Deferred, and disclosed: the server this name pairs with is seeded with
# `elastic` plus ELASTIC_PASSWORD only (compose.phase0.yml reads no ES_USER
# lever), so delivering it to the app would let the client ask for an account
# the server was never given - one half of a credential pair moved by a lever
# the other half ignores (#257 D05).
ES_USER=elastic
ES_PASSWORD=replace_me
# Host-publish port only (compose ${ES_PORT:-9200}); the client endpoint above
# is a separate lever and does not follow it inside the compose network.
ES_PORT=9200

# ============================================================
# Redis (Phase 0 — cache, locks, progress)
# ============================================================
REDIS_HOST=localhost
# Host-publish port only (compose ${REDIS_PORT:-6379}); the app containers reach
# redis on the compose network at 6379 and no app service reads this name,
# so moving it does not move the endpoint they use (#257 D02 defers it).
REDIS_PORT=6379
REDIS_PASSWORD=replace_me
# Bounded Redis client (performance lane): connect timeout applies to new
# sockets only; the health check pings idle connections so a dead peer
# does not hand out a corpse; one process holds at most this many connections.
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_MAX_CONNECTIONS=32
# Fleet-shared semantic cache backend for the provider policy layer
# (W44/W60): memory (default, per-process) | redis (shared across api/worker
# replicas, 50ms socket budgets, entries TTL = cache TTL). Evidence kinds
# (court|counterexample|accept_judge|contract_compile) are hard-excluded on
# both backends; a dead Redis is a miss, never a failure.
SPECPROOF_SEMANTIC_CACHE_BACKEND=memory

# ============================================================
# RabbitMQ (Phase 0 — task pipeline)
# ============================================================
RABBITMQ_HOST=localhost
# Host-publish port only (compose ${RABBITMQ_PORT:-5672}); the app containers reach
# rabbitmq on the compose network at 5672 and no app service reads this name,
# so moving it does not move the endpoint they use (#257 D02 defers it).
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=specproof
RABBITMQ_PASSWORD=replace_me
# ============================================================
# Product API credential
# ============================================================
# The key this service authenticates its own callers with (see the note under
# LLM_MODEL: workspace access uses this name, not LLM_API_KEY). It is left EMPTY
# rather than given a replace_me placeholder on purpose: compose.production.yml
# requires it as `${SPECPROOF_API_KEY:?set SPECPROOF_API_KEY}`, and compose's `:?`
# fires on an EMPTY value as well as an unset one, so an empty row still stops a
# stack that forgot it. A literal placeholder would be worse than empty -
# storage/config_guard.py checks this name for presence only (the nine
# credentials it compares by value are the DB/queue passwords below), so
# `replace_me` would pass the production guard and then api/auth.py would accept
# the one key value every reader of this file can guess.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SPECPROOF_API_KEY=


# ============================================================
# MinIO (Phase 0 — object storage)
# ============================================================
MINIO_HOST=localhost
# Host-publish port only (compose ${MINIO_PORT:-9000}); the app containers reach
# minio on the compose network at 9000 and no app service reads this name,
# so moving it does not move the endpoint they use (#257 D02 defers it).
MINIO_PORT=9000
# `minioadmin` is both MinIO's image default and compose.phase0.yml's
# `${MINIO_ROOT_USER:-minioadmin}` fallback, so #235 L03 keeps this row equal to
# it - but storage/config_guard.py refuses SPECPROOF_ENV=production while
# MINIO_ROOT_USER still equals this literal. Change both MINIO_ROOT_* rows before
# a production boot; the two rules can only coexist if the file names the rows
# they disagree about (R08 of
# tests/unit/test_compose_required_knobs_reach_the_operator.py pins that).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_me
MINIO_SECURE=false

# ============================================================
# App + observability host ports (industrialization phase 2)
# ============================================================
# Each value equals the compose file's own `${X:-...}` fallback, so a stack
# started WITHOUT .env and a stack started from this template get the same
# ports. These are host publishes; Prometheus scrapes service-name targets,
# so moving one does not move the scrape roster (gate:
# tests/unit/test_env_template_binds_the_compose_knobs.py).
GATEWAY_PORT=8080
GATEWAY_MANAGEMENT_PORT=8090
API_PORT=8000
PROMETHEUS_PORT=9090
# SLO 告警接收端 (compose.observability.yml 的 alertmanager 服务);
# 9093 是端口出厂值, 改动只影响宿主机发布端口 (抓取/路由走服务名 alertmanager:9093)。
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
OTEL_OTLP_GRPC_PORT=4317
OTEL_OTLP_HTTP_PORT=4318
OTEL_PROM_EXPORTER_PORT=8889

# Grafana's admin login. compose falls back to a literal dev value, i.e. a
# stack with no .env is reachable with a password that is in the repository.
# This row exists so that fallback is never what you ship.
GRAFANA_ADMIN_PASSWORD=replace_me

# Traces. compose's fallback is the value a deployed stack actually uses,
# while observability/tracing.py's own default additionally carries the
# /v1/traces path and localhost. The template keeps the deployed one.
# NOTE: neither docker/Dockerfile.api nor Dockerfile.worker installs the
# [otel] extra (both end in `pip install .`), so opentelemetry is absent in
# the shipped images, tracing degrades to NoOp, and until that extra is armed
# this variable moves nothing on the deployed plane.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Browser origins the API answers to. compose's fallback names only the web
# dev origin; api/server.py's own default additionally allows the API origin,
# which applies only when the variable is unset (running outside compose).
SPECPROOF_CORS_ORIGINS=http://localhost:3000

# Stuck-job sweep period (#68/#71) and the provider-wait park cap (#115).
# Both are read by agent/worker.py; 0 for the park cap means a job never
# releases on its own.
WORKER_RECLAIM_INTERVAL_SECONDS=300
WORKER_PROVIDER_PARK_MAX_SECONDS=0

# ============================================================
# GitHub integration (P5 — webhook + App Checks)
# ============================================================
# Webhook HMAC secret for POST /webhooks/github (fail-closed when absent).
# Empty, not a placeholder, and now delivered as `${GITHUB_WEBHOOK_SECRET:-}`.
# integrations/github.py HMACs with whatever this name holds, so the shipped
# placeholder would have become the signing secret of every stack copied from
# this file - and a `sha256=` header is forgeable by anyone who can read the
# repository. Empty keeps the fail-closed branch live (verification raises,
# POST /webhooks/github answers 503) until a real secret is set.
GITHUB_WEBHOOK_SECRET=

# GitHub App identity for Check Runs (specproof/verify).
# All three are required for publishing; leave unset to disable.
# The three GitHub App identity rows are empty on purpose now that compose
# passes them through: GitHubAppConfig.from_env() skips publishing only while
# every one of them is unset-or-empty, and raises on a partial set, so a
# delivered placeholder would turn a disabled integration into a config error
# at every publish point. Set all three (or none).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM key: set EITHER the key inline (use a secret manager in production)
# OR point at a key file — never commit real keys.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app-key.pem

# Public base URL used in Check Run details links (e.g. https://specproof.example.com).
# Deferred, and disclosed: compose never interpolates this name because its
# three shipped readers carry two different defaults ('' in the verify
# command and the webhook route, this origin in api/routes/admin.py), so no
# single fallback value keeps an untouched stack identical. Gate #235 L10
# pins the divergence; gate #257 pins the non-delivery (D02).
SPECPROOF_PUBLIC_URL=http://localhost:8000

# ============================================================
# Multi-tenant identity (industrialization phase 1, optional)
# ============================================================
# Leave every value unset to keep the single-tenant deployment unchanged.
# SPECPROOF_AUTH_ENABLED=true  (or OIDC_ISSUER set) activates tenant mode.
# Empty = off, which is what the reader's own default carries: 
# api/identity/config.py does `os.getenv(..., "").strip().lower()`, so an
# unset name and an empty one decide the same way. This row is now delivered
# as `${SPECPROOF_AUTH_ENABLED:-}` - before that carrier existed, the switch
# this file advertised could not be moved from .env at all, because no
# compose service read the name.
SPECPROOF_AUTH_ENABLED=
# '' = in-memory; 'sqlite:<path>'; 'mysql://user:pass@host/db'. Tenant-mode
# default when unset: sqlite:specproof_identity.db
SPECPROOF_IDENTITY_URL=
# HMAC key for local sp_* token hashes. No default on purpose (fail-closed).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Delivered as `${SPECPROOF_TOKEN_HMAC_KEY:-}`, so the row's value IS the
# deployed key: `replace_me` would have made a publicly readable string the
# HMAC key of every stack copied from this file, i.e. forgeable sp_* token
# hashes that still pass the presence-only production check. Empty keeps
# minting refused (api/identity/tokens.py raises instead of hashing with a
# default).
SPECPROOF_TOKEN_HMAC_KEY=
SPECPROOF_BCRYPT_ROUNDS=12
# OIDC (setting OIDC_ISSUER also enables tenant mode)
OIDC_ISSUER=
# Tenant-mode OIDC credentials, delivered as `${OIDC_CLIENT_ID:-}` and
# `${OIDC_CLIENT_SECRET:-}`. Empty matches the reader's default
# (api/identity/config.py strips an empty string to ""); a placeholder would
# be sent to the identity provider as a real client id and secret.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SPECPROOF_OIDC_ROLE_CLAIM=roles
SPECPROOF_OIDC_TENANT_CLAIM=tenant_id
SPECPROOF_DEFAULT_TENANT_ID=

# Agent history persists across API restarts; empty uses an ephemeral memory store.
# SPECPROOF_AGENT_JOBS_URL=sqlite:.local/specproof_agent_jobs.db
# Console journal follows AGENT_JOBS_URL by default (SQLite or MySQL).
# Only set an override when the journal needs a separate database.
# SPECPROOF_AGENT_CONSOLE_URL=sqlite:.local/specproof_agent_console.db

# ============================================================
# Notify outbox / webhook delivery (optional)
# ============================================================
# These three are read by storage/notify_relay.py (and the worker path that
# enqueues into the outbox). The shipped stack's `compose.production.yml`
# already sets them; a stack started without .env gets them unset, and the
# notify lane then reads as "opt-in webhook" with the sender DISABLED
# (no network calls are made).
#   SPECPROOF_NOTIFY_OUTBOX=1   opt into the durable outbox lane instead of live send
#   SPECPROOF_NOTIFY_WEBHOOK_URL      absolute URL of the receiver
#   SPECPROOF_NOTIFY_WEBHOOK_SECRET   HMAC key for x-specproof-signature
#   SPECPROOF_NOTIFY_WEBHOOK_KIND     slack | generic | feishu (default generic)
# Empty = disabled: the worker sends nothing out; rows stay terminal
# until an operator enables the lane (SPECPROOF_NOTIFY_OUTBOX=1) with a URL.
# (compose.production.yml pins the worker itself to "1" - the shipped outbox
# lane is armed by whoever deploys this compose file, independent of this
# row; this row is what the API's own notify enqueue path and any other
# interpolation site will see)
SPECPROOF_NOTIFY_OUTBOX=
SPECPROOF_NOTIFY_WEBHOOK_URL=
SPECPROOF_NOTIFY_WEBHOOK_SECRET=
# Empty = WebhookKind.GENERIC (the shipped webhook.py maps unset/empty to GENERIC)
SPECPROOF_NOTIFY_WEBHOOK_KIND=

# ============================================================
# Invoice cron (optional output, defaults to no-op)
# ============================================================
# Optional sidecar on the production compose profile (`docker compose --profile
# billing up -d invoice-cron`). SPECPROOF_BILLING_URL unset/empty = honest no-op:
# storage/invoice_cron.py starts, finds no store, and generates nothing. With a
# connection string it invoices each closed calendar month per tenant.
SPECPROOF_BILLING_URL=
# How often the invoice cron ticks; the shipped default (storage/invoice_cron.py
# DEFAULT_INTERVAL_SECONDS = 3600.0) is once an hour.
INVOICE_CRON_INTERVAL_SECONDS=3600.0
# Force one specific invoice period (e.g. "2026-09"), otherwise the cron
# follows the previous closed calendar month.
SPECPROOF_INVOICE_PERIOD=

# W190 six-event observability bus (edge + agent sides). Default is OFF
# (exact value "1" enables it): on with no broker topology in place fails loudly,
# not silently. Both sides must be on in the same deployment.
SPECPROOF_MQ_EVENTS_ENABLED=0

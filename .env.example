# SpecProof Phase 0
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ============================================================
# LLM Provider
# ============================================================
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_API_KEY=replace_me
# Model and protocol. Workspace access uses SPECPROOF_API_KEY, not LLM_API_KEY.
LLM_MODEL=gpt-6-astra
LLM_PROTOCOL=responses
LLM_REASONING_EFFORT=max
# Thinking-mode policy for task templates (providers/prompt_templates.py):
#   plan_only (default) — request thinking only for plan/judge/diagnose tasks;
#   auto       — follow each template's thinking_on flag;
#   off        — never request thinking (the gateway's always-on thinking may
#                still run; this only stops the client from requesting it).
LLM_THINKING_MODE=plan_only
# Per-run Craft resource gate. These five names are the only variables
# craft/budget.py Budget.from_env reads; `specproof craft --budget-tokens`
# overrides CRAFT_TOKEN_BUDGET for one run. Each must be a positive integer:
# Budget._env_int raises BudgetError on 0, a negative, or a non-numeric
# value, so "0 = no enforcement" is NOT a thing here (the row this replaced
# claimed it). Values below are read from craft/budget.py's own DEFAULT_*
# constants.
# CAVEAT, disclosed not hidden: CRAFT_TOKEN_BUDGET has TWO defaults in the
#   craft/budget.py -> 200000
#   craft/llm.py -> 500000
# The budget that gates the run is the one above from budget.py; the LLM
# client's own cap differs, and the CLI help text quotes only one of them.
CRAFT_MAX_ITERATIONS=12
CRAFT_MAX_STEPS=12
CRAFT_MAX_TOOL_CALLS=40
CRAFT_TOKEN_BUDGET=200000
CRAFT_TIMEOUT_MINUTES=60
LLM_MAX_RETRIES=2

# ============================================================
# Deployment mode (arms the production credential guard)
# ============================================================
# storage/config_guard.py runs its refusal checks only when this equals
# `production`, and api/server.py calls the guard at import. compose.production.yml
# sets it for every app service, so a deployed stack is armed whether or not this
# file exists; the row covers the plane OUTSIDE compose, where an unset value
# leaves the guard inert and a shipped default password boots without complaint.
# It stays commented on purpose: uncommenting it in a dev checkout makes the guard
# reject this file's own dev defaults (MYSQL_USER=specproof, MINIO_ROOT_USER=minioadmin)
# until they are changed - which is the point, not a side effect.
# Reachability of the guard is gated by tests/unit/test_production_guard_reachability.py
# (#79); that the knob is inventoried here is gated by
# tests/unit/test_compose_required_knobs_reach_the_operator.py (R07).
# SPECPROOF_ENV=production

# ============================================================
# MySQL (Phase 0 — business truth)
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=specproof_phase0
# The account name is part of the credential: storage/config_guard.py refuses
# SPECPROOF_ENV=production while MYSQL_USER still equals `specproof`, the account
# the product database is seeded with. The value stays equal to compose.phase0.yml's
# own `${MYSQL_USER:-specproof}` fallback because that is what makes a copied
# template boot (gate #235 L03 pins the two together), so the row is a DEV default
# that has to change before production - disclosed here, not silently replaced.
MYSQL_USER=specproof
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_me
# Socket deadlines in seconds keep unavailable databases from hanging requests.
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=15
MYSQL_WRITE_TIMEOUT=15

# ============================================================
# MongoDB (Phase 0 — analysis artifacts)
# ============================================================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=specproof_phase0
MONGODB_USER=specproof
MONGODB_PASSWORD=replace_me

# ============================================================
# Elasticsearch (Phase 0 — code retrieval)
# ============================================================
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=replace_me
# Host-publish port only (compose ${ES_PORT:-9200}); the client endpoint above
# is a separate lever and does not follow it inside the compose network.
ES_PORT=9200

# ============================================================
# Redis (Phase 0 — cache, locks, progress)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_me

# ============================================================
# RabbitMQ (Phase 0 — task pipeline)
# ============================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=specproof
RABBITMQ_PASSWORD=replace_me
# ============================================================
# Product API credential
# ============================================================
# The key this service authenticates its own callers with (see the note under
# LLM_MODEL: workspace access uses this name, not LLM_API_KEY). It is left EMPTY
# rather than given a replace_me placeholder on purpose: compose.production.yml
# requires it as `${SPECPROOF_API_KEY:?set SPECPROOF_API_KEY}`, and compose's `:?`
# fires on an EMPTY value as well as an unset one, so an empty row still stops a
# stack that forgot it. A literal placeholder would be worse than empty -
# storage/config_guard.py checks this name for presence only (the nine
# credentials it compares by value are the DB/queue passwords below), so
# `replace_me` would pass the production guard and then api/auth.py would accept
# the one key value every reader of this file can guess.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SPECPROOF_API_KEY=


# ============================================================
# MinIO (Phase 0 — object storage)
# ============================================================
MINIO_HOST=localhost
MINIO_PORT=9000
# `minioadmin` is both MinIO's image default and compose.phase0.yml's
# `${MINIO_ROOT_USER:-minioadmin}` fallback, so #235 L03 keeps this row equal to
# it - but storage/config_guard.py refuses SPECPROOF_ENV=production while
# MINIO_ROOT_USER still equals this literal. Change both MINIO_ROOT_* rows before
# a production boot; the two rules can only coexist if the file names the rows
# they disagree about (R08 of
# tests/unit/test_compose_required_knobs_reach_the_operator.py pins that).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_me
MINIO_SECURE=false

# ============================================================
# App + observability host ports (industrialization phase 2)
# ============================================================
# Each value equals the compose file's own `${X:-...}` fallback, so a stack
# started WITHOUT .env and a stack started from this template get the same
# ports. These are host publishes; Prometheus scrapes service-name targets,
# so moving one does not move the scrape roster (gate:
# tests/unit/test_env_template_binds_the_compose_knobs.py).
API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
OTEL_OTLP_GRPC_PORT=4317
OTEL_OTLP_HTTP_PORT=4318
OTEL_PROM_EXPORTER_PORT=8889

# Grafana's admin login. compose falls back to a literal dev value, i.e. a
# stack with no .env is reachable with a password that is in the repository.
# This row exists so that fallback is never what you ship.
GRAFANA_ADMIN_PASSWORD=replace_me

# Traces. compose's fallback is the value a deployed stack actually uses,
# while observability/tracing.py's own default additionally carries the
# /v1/traces path and localhost. The template keeps the deployed one.
# NOTE: neither docker/Dockerfile.api nor Dockerfile.worker installs the
# [otel] extra (both end in `pip install .`), so opentelemetry is absent in
# the shipped images, tracing degrades to NoOp, and until that extra is armed
# this variable moves nothing on the deployed plane.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Browser origins the API answers to. compose's fallback names only the web
# dev origin; api/server.py's own default additionally allows the API origin,
# which applies only when the variable is unset (running outside compose).
SPECPROOF_CORS_ORIGINS=http://localhost:3000

# Stuck-job sweep period (#68/#71) and the provider-wait park cap (#115).
# Both are read by agent/worker.py; 0 for the park cap means a job never
# releases on its own.
WORKER_RECLAIM_INTERVAL_SECONDS=300
WORKER_PROVIDER_PARK_MAX_SECONDS=0

# ============================================================
# GitHub integration (P5 — webhook + App Checks)
# ============================================================
# Webhook HMAC secret for POST /webhooks/github (fail-closed when absent).
GITHUB_WEBHOOK_SECRET=replace_me

# GitHub App identity for Check Runs (specproof/verify).
# All three are required for publishing; leave unset to disable.
GITHUB_APP_ID=replace_me
GITHUB_APP_INSTALLATION_ID=replace_me
# PEM key: set EITHER the key inline (use a secret manager in production)
# OR point at a key file — never commit real keys.
GITHUB_APP_PRIVATE_KEY=replace_me
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app-key.pem

# Public base URL used in Check Run details links (e.g. https://specproof.example.com).
SPECPROOF_PUBLIC_URL=http://localhost:8000

# ============================================================
# Multi-tenant identity (industrialization phase 1, optional)
# ============================================================
# Leave every value unset to keep the single-tenant deployment unchanged.
# SPECPROOF_AUTH_ENABLED=true  (or OIDC_ISSUER set) activates tenant mode.
SPECPROOF_AUTH_ENABLED=false
# '' = in-memory; 'sqlite:<path>'; 'mysql://user:pass@host/db'. Tenant-mode
# default when unset: sqlite:specproof_identity.db
SPECPROOF_IDENTITY_URL=
# HMAC key for local sp_* token hashes. No default on purpose (fail-closed).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SPECPROOF_TOKEN_HMAC_KEY=replace_me
SPECPROOF_BCRYPT_ROUNDS=12
# OIDC (setting OIDC_ISSUER also enables tenant mode)
OIDC_ISSUER=
OIDC_CLIENT_ID=replace_me
OIDC_CLIENT_SECRET=replace_me
SPECPROOF_OIDC_ROLE_CLAIM=roles
SPECPROOF_OIDC_TENANT_CLAIM=tenant_id
SPECPROOF_DEFAULT_TENANT_ID=

# Agent history persists across API restarts; empty uses an ephemeral memory store.
# SPECPROOF_AGENT_JOBS_URL=sqlite:.local/specproof_agent_jobs.db
# Console journal follows AGENT_JOBS_URL by default (SQLite or MySQL).
# Only set an override when the journal needs a separate database.
# SPECPROOF_AGENT_CONSOLE_URL=sqlite:.local/specproof_agent_console.db

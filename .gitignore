eval-report.results.jsonl
services/control-plane/target/

# Local test-run logs (evidence lives in reports/ artifacts)
.pytest-*.log
.probe-*.log
.probe-*.json
# Gate runs write here when not redirected into .local/ by the caller.
gate_*.log
gate_*.err
# Local scratch notes written to the repo root by interactive sessions.
anchor.txt
golden-cases-first/
golden-cases-rem/
golden-cases-rel/
golden-cases-c1/
golden-cases-c2/
